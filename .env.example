# Service
# 使用 Uvicorn 命令行启动时，仍需通过 --host 和 --port 传入。
ANCHR_DOCLING_HOST=127.0.0.1
ANCHR_DOCLING_PORT=8091
ANCHR_DOCLING_ENABLE_DOCS=false

# Authentication and source downloads
# 必须替换。可使用 `openssl rand -hex 32` 生成，并与 App 的
# APP_DOCLING_API_TOKEN 保持一致。
ANCHR_DOCLING_API_TOKEN=change-me
# 逗号分隔的精确主机名；只允许 HTTPS 默认端口。
ANCHR_DOCLING_ALLOWED_DOWNLOAD_HOSTS=change-me
ANCHR_DOCLING_MAX_DOWNLOAD_REDIRECTS=3
ANCHR_DOCLING_MAX_DOWNLOAD_MB=100
ANCHR_DOCLING_MAX_IMAGE_MEGAPIXELS=80
ANCHR_DOCLING_CONNECT_TIMEOUT_SECONDS=10
ANCHR_DOCLING_READ_TIMEOUT_SECONDS=120

# Queue and in-memory results
ANCHR_DOCLING_WORKERS=1
ANCHR_DOCLING_QUEUE_CAPACITY=8
ANCHR_DOCLING_QUEUE_WAIT_TIMEOUT_SECONDS=1800
ANCHR_DOCLING_RESULT_TTL_SECONDS=600
ANCHR_DOCLING_MAX_RETAINED_RESULTS=16

# Docling models and OCR
ANCHR_DOCLING_DEVICE=cpu
ANCHR_DOCLING_PRELOAD_MODELS=true
ANCHR_DOCLING_PRELOAD_OCR_MODELS=false
ANCHR_DOCLING_OCR_ENGINES=ocrmac,rapidocr
ANCHR_DOCLING_OCR_LANG=chinese
ANCHR_DOCLING_FORCE_FULL_PAGE_OCR=true

# Embedded-image upload
# 留空表示不配置解密密钥。启用 v3 图片上传时，可使用
# `openssl rand -base64 32` 生成 32 字节 AES 密钥，并与 App 保持一致。
ANCHR_DOCLING_OSS_ENCRYPT_KEY=
# JSON 数组；每条规则必须同时匹配 endpoint、bucket 和 prefix。
# Example: [{"endpoint":"oss-cn-shanghai.aliyuncs.com","bucket":"my-bucket","prefix":"embedded"}]
ANCHR_DOCLING_ALLOWED_UPLOAD_TARGETS=[]
